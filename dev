#!/usr/bin/env bash
# Common tasks. Everything runs in Docker; the host needs only bash and Docker.
#   ./dev build [AREAS] [BUILD]   build tiles for community areas: 32, 32,8 or all (default 32, build "dev")
#   ./dev app                     run the viewer at http://localhost:5173
#   ./dev eval [VIEWS]            screenshot viewpoints into eval/out/ (starts the viewer if needed)
#   ./dev share                   public URL for the current build (Cloudflare quick tunnel); ./dev unshare stops it
#   ./dev precompress [BUILD]     Brotli-compress a build's tiles for the shared link (default: the current build)
#   ./dev photomatch PHOTO [--toward=X,Y]   a street photo beside the map from the same spot (data/work/photomatch/)
#   ./dev smoke                   click a building and walk into a wall in headless Chromium
#   ./dev test                    pipeline tests + TypeScript check
#   ./dev areas                   list the 77 community areas
#   ./dev shell                   shell in the pipeline container
#   ./dev clean                   delete intermediate files and builds (keeps downloads)
set -euo pipefail
cd "$(dirname "$0")"
export UID 2>/dev/null || true  # bash sets UID (read-only); docker compose needs it exported
export GID="${GID:-$(id -g)}"
pipeline() { docker compose run --rm pipeline "$@"; }
web() { docker compose run --rm --no-deps web sh -c "corepack pnpm install --frozen-lockfile --reporter=silent && $*"; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  build)
    areas="${1:-32}"; build="${2:-dev}"
    docker compose build -q pipeline
    # FORCE=1 rebuilds the tiles even if Snakemake thinks they're current
    # (for example after running `python -m cim tiles` by hand).
    pipeline snakemake -s pipeline/Snakefile -d . --cores "${CORES:-$(nproc)}" --resources http=4 \
      ${FORCE:+--forcerun tiles} --config areas="$areas" build="$build"
    ;;
  app)
    docker compose up web
    ;;
  eval)
    docker compose up -d web >/dev/null
    docker compose run --rm ${1:+-e VIEWS="$1"} eval sh -c \
      "npm ci --no-audit --no-fund --loglevel=error >/dev/null && node render.mjs"
    ;;
  precompress)
    build="${1:-$(python3 -c "import json; print(json.load(open('data/builds/manifest.json'))['current'])")}"
    docker compose run --rm --no-deps -e UV_THREADPOOL_SIZE=8 web node scripts/precompress.mjs "../data/builds/$build"
    ;;
  share)
    "$0" precompress
    docker compose up -d preview tunnel
    echo "Building the viewer and opening a tunnel…"
    for _ in $(seq 1 90); do
      url=$(docker compose logs tunnel 2>/dev/null | grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' | tail -1 || true)
      if [ -n "$url" ] && curl -sf -o /dev/null "http://localhost:4173/"; then
        echo "$url"; exit 0
      fi
      sleep 2
    done
    echo "No tunnel URL yet; check: docker compose logs tunnel preview" >&2; exit 1
    ;;
  unshare)
    docker compose stop tunnel preview
    ;;
  photomatch)
    photo="$1"; shift
    name=$(pipeline python -m cim photomatch-pose "$photo" "$@" | tail -1 | python3 -c "import json, sys; print(json.load(sys.stdin)['name'])")
    docker compose up -d web >/dev/null
    docker compose run --rm -e NAME="$name" eval sh -c "npm ci --no-audit --no-fund --loglevel=error >/dev/null && node photomatch.mjs"
    pipeline python -m cim photomatch-compose "$name"
    ;;
  smoke)
    docker compose up -d web >/dev/null
    docker compose run --rm eval sh -c "npm ci --no-audit --no-fund --loglevel=error >/dev/null && node smoke.mjs"
    ;;
  test)
    docker compose build -q pipeline
    pipeline pytest -q pipeline/tests
    web "corepack pnpm check"
    ;;
  areas)
    pipeline python -m cim areas
    ;;
  shell)
    pipeline bash
    ;;
  clean)
    rm -rf data/work data/builds
    ;;
  *)
    awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"
    ;;
esac
