# Build workflow. Run from the repo root (the Makefile does this for you):
#   snakemake -s pipeline/Snakefile -d . --cores 4 --config areas=32 build=dev
_areas = str(config.get("areas", "32"))
AREAS = list(range(1, 78)) if _areas == "all" else [int(a) for a in _areas.split(",")]
BUILD = config.get("build", "dev")
PY = "python -m cim"

# Steps depend on their own code too, so editing a module rebuilds what it produces.
def code(*modules):
    return [f"pipeline/cim/{m}.py" for m in modules] + ["pipeline/config.yaml"]

rule all:
    input: f"data/builds/{BUILD}/tileset.json"

rule fetch_osm:
    output: "data/raw/osm_illinois/illinois-latest.osm.pbf"
    shell: f"{PY} fetch osm_illinois"

rule fetch_areas:
    output: "data/raw/community_areas/community_areas.geojson"
    shell: f"{PY} fetch community_areas"

rule fetch_city_footprints:
    input: rules.fetch_areas.output
    output: "data/raw/city_footprints/area-{area}.geojson"
    resources: http=1
    shell: PY + " fetch city_footprints --area {wildcards.area}"

rule osm_features:
    input: rules.fetch_osm.output, code("osm")
    output: "data/work/osm/features.parquet"
    shell: f"{PY} osm"

rule buildings:
    input:
        rules.osm_features.output,
        rules.fetch_areas.output,
        "data/raw/city_footprints/area-{area}.geojson",
        code("buildings", "heights", "areas"),
    output: "data/work/area-{area}/buildings.parquet"
    shell: PY + " buildings --area {wildcards.area}"

rule lidar:
    # Per-block outputs are cached in data/work/lidar/; blocks that already exist are skipped.
    input:
        expand("data/work/area-{area}/buildings.parquet", area=AREAS),
        code("lidar", "tiles", "grid"),
    output: touch(f"data/work/lidar/{BUILD}.done")
    params: areas=",".join(map(str, AREAS))
    threads: workflow.cores
    shell: PY + " lidar --areas {params.areas}"

rule roofs:
    # Per-block roofer outputs are cached in data/work/roofs/; existing blocks are skipped.
    input: rules.lidar.output, code("roofs", "lidar", "tiles")
    output: touch(f"data/work/roofs/{BUILD}.done")
    params: areas=",".join(map(str, AREAS))
    threads: workflow.cores
    shell: PY + " roofs --areas {params.areas}"

rule tiles:
    input:
        rules.lidar.output,
        rules.roofs.output,
        expand("data/work/area-{area}/buildings.parquet", area=AREAS),
        rules.osm_features.output,
        code("tiles", "ground", "grid", "mesh", "gltf", "frame", "minimap"),
    output: f"data/builds/{BUILD}/tileset.json"
    params: areas=",".join(map(str, AREAS))
    threads: workflow.cores
    shell: f"CIM_WORKERS={{threads}} {PY} tiles --areas {{params.areas}} --build {BUILD} && {PY} agent-state"
